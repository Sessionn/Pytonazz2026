DISCORD_TOKEN=

# Owner/dev (opzionale ma consigliato)
OWNER_ID=
DEV_IDS=
DEV_ID=

# Spotify (opzionale)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AI providers
# Almeno uno tra GROQ_API_KEY (provider emergency) configurato
GROQ_API_KEY=

# Sync guild (opzionale, CSV di ID server separati da virgola)
GUILD_IDS=

# Proxy yt-dlp (opzionale — solo per VM/VPS con restrizioni YouTube)
YTDLP_PROXY=

# Proxy FFmpeg (opzionale; fallback su YTDLP_PROXY solo se HTTP/HTTPS)
FFMPEG_PROXY=

# Cookie Netscape (opzionale — migliora il download da YouTube)
# Usa il percorso ASSOLUTO per evitare ambiguita' sulla working directory
# Esempio: COOKIE_FILE=/home/sessionn/cookies.txt
COOKIE_FILE=

# Livello di log (opzionale; DEBUG mostra la griglia enrichment Spotify, default: INFO)
LOG_LEVEL=INFO

# Banner console
SHOW_BANNER=true

# Song Cache DB
# Abilita il sistema di cache SQLite per le tracce (true/false)
CACHE_ENABLED=false
# Path del file SQLite (default: data/database/cache.db)
DB_PATH=data/database/cache.db
# Scadenza entry in giorni (default: 30)
CACHE_TTL_DAYS=30
# Numero massimo di entry (le piu' vecchie vengono rimosse automaticamente)
CACHE_MAX_ENTRIES=500

# SOCKET DASHBOARD (default 0.0.0.0:5000)
DASHBOARD_SOCKET=0.0.0.0:5000