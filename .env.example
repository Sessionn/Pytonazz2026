DISCORD_TOKEN=
# Sicurezza: non riusare token o chiavi comparse in log, screenshot, PDF o chat.
# In caso di esposizione, rigenera subito Discord token, Spotify secret,
# Groq key, DASH_PASSWORD e DASH_SECRET_KEY nei rispettivi portali.

# Owner/dev (opzionale ma consigliato)
OWNER_ID=
DEV_IDS=
DEV_ID=

# Spotify (opzionale)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AI providers
# Almeno uno tra GROQ_API_KEY (provider emergency) configurato
GROQ_API_KEY=

# Sync guild (opzionale, CSV di ID server separati da virgola)
GUILD_IDS=

# Proxy yt-dlp (opzionale — solo per VM/VPS con restrizioni YouTube)
YTDLP_PROXY=

# Proxy FFmpeg (opzionale; fallback su YTDLP_PROXY solo se HTTP/HTTPS)
FFMPEG_PROXY=

# Cookie Netscape (opzionale — migliora il download da YouTube)
# Usa il percorso ASSOLUTO per evitare ambiguita' sulla working directory
# Esempio: COOKIE_FILE=/home/sessionn/cookies.txt
COOKIE_FILE=

# Livello di log (opzionale; DEBUG mostra la griglia enrichment Spotify, default: INFO)
LOG_LEVEL=INFO

# Banner console
SHOW_BANNER=true

# Song Cache DB
# Abilita il sistema di cache SQLite per le tracce (true/false)
CACHE_ENABLED=false
# Path del file SQLite (default: data/database/cache.db)
DB_PATH=data/database/cache.db
# Scadenza entry in giorni (default: 30)
CACHE_TTL_DAYS=30
# Numero massimo di entry (le piu' vecchie vengono rimosse automaticamente)
CACHE_MAX_ENTRIES=500

# ── Dashboard ────────────────────────────────────────────────────────────────
# Indirizzo e porta della dashboard locale; in produzione resta dietro reverse proxy HTTPS
DASHBOARD_SOCKET=127.0.0.1:5000

# Credenziali login dashboard
DASH_USER=admin
DASH_PASSWORD=changeme

# Chiave segreta per le sessioni Flask/waitress (genera con: python3 -c "import secrets; print(secrets.token_hex(32))")
DASH_SECRET_KEY=

# Se true, Flask si fida degli header X-Forwarded-* del reverse proxy
DASH_TRUST_PROXY=true

# Cookie sessione dashboard
# true in produzione HTTPS dietro reverse proxy
DASH_SESSION_SECURE=true
DASH_SESSION_SAMESITE=Lax

# Rate limit login
DASH_LOGIN_WINDOW_SECONDS=900
DASH_LOGIN_MAX_ATTEMPTS=5

# Log connessioni di rete anomale (scanner TLS/bot) — NET_SCAN nel log
# true  = le vedi nel log con tag [NET_SCAN] a livello WARNING
# false = vengono scartate silenziosamente
DASH_LOG_SCANNERS=false
