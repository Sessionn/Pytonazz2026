DISCORD_TOKEN=

# Owner/dev (opzionale ma consigliato)
OWNER_ID=
DEV_IDS=
DEV_ID=

# Spotify (opzionale)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AI providers (almeno uno dei due)
GEMINI_API_KEY=
GROQ_API_KEY=

# Sync guild (opzionale, CSV)
GUILD_IDS=

# Proxy yt-dlp (opzionale)
YTDLP_PROXY=

# Proxy FFmpeg (opzionale; fallback su YTDLP_PROXY solo se HTTP/HTTPS)
FFMPEG_PROXY=

# Livello di log (opzionale; DEBUG mostra la griglia di enrichment Spotify, default: INFO)
LOG_LEVEL=INFO

# Banner console
SHOW_BANNER=true

# ── Cache query musicali (opzionale) ────────────────────────────────────────────
# Abilita il sistema di cache: la prima volta che una canzone viene cercata
# il risultato viene salvato in un DB SQLite locale. Alle ricerche successive
# con la stessa query (o simile) il bot bypassa yt-dlp e parte direttamente
# dal link salvato, riducendo i tempi di risoluzione da ~3-5s a < 1s.
#
# Per attivare basta impostare QUERY_CACHE_ENABLED=true e riavviare il bot.
# Puoi anche usare /cache on | off senza riavviare (toggle a runtime).
#
QUERY_CACHE_ENABLED=false
#
# Path del file SQLite (relativo alla root del bot)
QUERY_CACHE_DB_PATH=./cache.db
#
# Dopo quanti giorni un'entry viene considerata scaduta e ricercata di nuovo
QUERY_CACHE_TTL_DAYS=30
#
# Numero massimo di entry nel DB (le più vecchie vengono rimosse automaticamente)
QUERY_CACHE_MAX_ENTRIES=5000
