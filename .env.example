DISCORD_TOKEN=

# Owner/dev (opzionale ma consigliato)
OWNER_ID=
DEV_IDS=
DEV_ID=

# Spotify (opzionale)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AI providers (almeno uno dei due)
GEMINI_API_KEY=
GROQ_API_KEY=

# Sync guild (opzionale, CSV)
GUILD_IDS=

# Proxy yt-dlp (opzionale)
YTDLP_PROXY=

# Proxy FFmpeg (opzionale; fallback su YTDLP_PROXY solo se HTTP/HTTPS)
FFMPEG_PROXY=

# Livello di log (opzionale; DEBUG mostra la griglia di enrichment Spotify, default: INFO)
LOG_LEVEL=INFO

# Banner console
SHOW_BANNER=true

# Song Cache DB
# Abilita il sistema di cache (true/false)
CACHE_ENABLED=false
# Path del file SQLite (default: data/database/cache.db)
DB_PATH=data/database/cache.db
# Scadenza entry in giorni (default: 30)
CACHE_TTL_DAYS=30
# Numero massimo di entry (le piu' vecchie vengono rimosse automaticamente)
CACHE_MAX_ENTRIES=500
